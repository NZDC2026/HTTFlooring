# Local development only. Replace all three before starting Compose; never commit .env.
HTT_OWNER_PASSWORD=replace-with-local-owner-password
HTT_APP_PASSWORD=replace-with-local-api-password
HTT_WORKER_PASSWORD=replace-with-local-worker-password
HTT_DB_PORT=55432
HTT_API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
HTT_AUTHORITY=
HTT_AUDIENCE=
HTT_AUTH_MODE=Oidc
