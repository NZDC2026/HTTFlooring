# Local development only. Replace all four before starting Compose; never commit .env.
HTT_OWNER_PASSWORD=replace-with-local-owner-password
HTT_APP_PASSWORD=replace-with-local-api-password
HTT_WORKER_PASSWORD=replace-with-local-worker-password
HTT_PORTAL_PASSWORD=replace-with-local-portal-password
HTT_DB_PORT=55432
HTT_API_PORT=5080
ASPNETCORE_ENVIRONMENT=Development
HTT_AUTHORITY=
HTT_AUDIENCE=
HTT_AUTH_MODE=Oidc
# Separate customer OIDC application/client. Blank keeps portal routes locked.
HTT_PORTAL_AUTHORITY=
HTT_PORTAL_AUDIENCE=
HTT_PORTAL_AUTH_MODE=Oidc
# Document mail: verified Resend sender; key is used only by Worker. No mail is sent until configured.
HTT_MAIL_FROM=
HTT_MAIL_API_KEY=
# Private ClamAV TCP endpoint. Uploads remain unavailable until scanning succeeds.
HTT_CLAMAV_HOST=
HTT_CLAMAV_PORT=3310
# Optional HTTPS OCR gateway; Worker only. Receives only user-selected card images after clean scan.
HTT_CARD_OCR_ENDPOINT=
HTT_CARD_OCR_API_KEY=
