# Development example only. No credentials or remote service addresses.
# Spring Boot and Maven do not automatically read .env files.
# Set these variables in your shell or IDE run configuration.
SPRING_PROFILES_ACTIVE=local
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=8080

# Reserved for a separately authorized local database task; unused by local/test.
# Keep the database profile disabled during the initialization phase.
# HTT_DB_URL=jdbc:postgresql://127.0.0.1:5432/htt_management_dev
# HTT_DB_USERNAME=htt_management_dev_app
# HTT_DB_PASSWORD=

# Bearer authentication remains disabled until V3 and explicit identity bindings are provisioned.
# Auth requires JDBC; local/test profiles deliberately have no database.
HTT_AUTH_ENABLED=false
# Use distinct staff/portal audiences. For COGNITO, audience means the client_id for access tokens.
# HTT_STAFF_ISSUER=
# HTT_STAFF_AUDIENCE=
# HTT_STAFF_JWKS_URI=
# HTT_STAFF_AUTH_MODE=OIDC
# HTT_PORTAL_ISSUER=
# HTT_PORTAL_AUDIENCE=
# HTT_PORTAL_JWKS_URI=
# HTT_PORTAL_AUTH_MODE=OIDC
