# Development IP issuer; trust the development CA in a dedicated Java truststore first.
# No automatic loading. Enable only after actual Java identity bindings and target DB migrations exist.
HTT_AUTH_ENABLED=false
HTT_STAFF_AUTH_MODE=OIDC
HTT_STAFF_ISSUER=https://192.168.10.174:18443/realms/htt-staff
HTT_STAFF_AUDIENCE=htt-staff-api
HTT_STAFF_JWKS_URI=https://192.168.10.174:18443/realms/htt-staff/protocol/openid-connect/certs
HTT_PORTAL_AUTH_MODE=OIDC
HTT_PORTAL_ISSUER=https://192.168.10.174:18443/realms/htt-customer
HTT_PORTAL_AUDIENCE=htt-portal-api
HTT_PORTAL_JWKS_URI=https://192.168.10.174:18443/realms/htt-customer/protocol/openid-connect/certs
