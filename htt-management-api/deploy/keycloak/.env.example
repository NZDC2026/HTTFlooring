# Preparation only. Replace identifiers; put passwords in external secret files, never here.
# Choose an official supported release and pin its inspected digest after the deployment smoke test.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:REVIEWED_VERSION@sha256:REVIEWED_DIGEST
KEYCLOAK_HOSTNAME=https://identity.example.invalid:18443
KEYCLOAK_BIND_ADDRESS=127.0.0.1
KEYCLOAK_HTTPS_PORT=18443
KEYCLOAK_MANAGEMENT_PORT=19000
KEYCLOAK_MEMORY_LIMIT=2g
KEYCLOAK_CPU_LIMIT=2
KEYCLOAK_DB_URL=jdbc:postgresql://postgres.example.invalid:5432/htt_keycloak?sslmode=verify-full&sslrootcert=/run/secrets/pg_root_cert
KEYCLOAK_DB_USERNAME=htt_keycloak
KEYCLOAK_DB_PASSWORD_FILE=/secure/htt-keycloak/db-password
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=temporary-bootstrap
KEYCLOAK_BOOTSTRAP_PASSWORD_FILE=/secure/htt-keycloak/bootstrap-password
KEYCLOAK_HTTPS_CERT_FILE=/secure/htt-keycloak/https-chain.pem
KEYCLOAK_HTTPS_KEY_FILE=/secure/htt-keycloak/https-key.pem
KEYCLOAK_PG_ROOT_CERT_FILE=/secure/htt-keycloak/postgres-ca.pem
HTT_ADMIN_REDIRECT_URI=https://admin.example.invalid/auth/callback
HTT_ADMIN_ORIGIN=https://admin.example.invalid
HTT_SALES_REDIRECT_URI=https://app.example.invalid/auth/callback
HTT_PORTAL_REDIRECT_URI=https://portal.example.invalid/auth/callback
HTT_PORTAL_ORIGIN=https://portal.example.invalid
