# Java API identifiers only. This file is NOT automatically loaded by Spring Boot.
# Keep disabled until real IdP + PostgreSQL authorization E2E acceptance.
HTT_AUTH_ENABLED=false
HTT_STAFF_AUTH_MODE=OIDC
HTT_STAFF_ISSUER=https://identity.example.invalid:18443/realms/htt-staff
HTT_STAFF_AUDIENCE=htt-staff-api
HTT_STAFF_JWKS_URI=https://identity.example.invalid:18443/realms/htt-staff/protocol/openid-connect/certs
HTT_PORTAL_AUTH_MODE=OIDC
HTT_PORTAL_ISSUER=https://identity.example.invalid:18443/realms/htt-customer
HTT_PORTAL_AUDIENCE=htt-portal-api
HTT_PORTAL_JWKS_URI=https://identity.example.invalid:18443/realms/htt-customer/protocol/openid-connect/certs
