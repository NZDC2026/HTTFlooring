# Include inside an existing HTTPS server block. Define htt_api upstream separately.
# Example only; no server configuration is changed by the application.
location ~ ^/api/(v1|portal/v1)/notifications/stream$ {
    proxy_pass http://htt_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header Authorization $http_authorization;
    proxy_buffering off;
    proxy_cache off;
    gzip off;
    proxy_read_timeout 75s;
    send_timeout 30s;
    add_header X-Accel-Buffering no always;
}
