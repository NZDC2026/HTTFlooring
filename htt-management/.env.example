# Copy this file to .env. Shell/CI variables override .env.
# Missing .env values use these non-secret defaults. Never prefix secrets with VITE_.

# Web server
HOST=127.0.0.1
API_PORT=8787
HTT_DATA_DIR=web-data
# Local development: blank origin permits localhost only. Production: exact HTTPS origin, no trailing slash.
PUBLIC_ORIGIN=
COOKIE_SECURE=0
HTT_OCR_HELPER=dist-ocr/htt-ocr

# Customer Quote / Order follow-up email (server only). Leave blank until configured.
RESEND_API_KEY=

# Build: 0 = Electron; 1 = web. pnpm build:web supplies 1 automatically.
WEB_ONLY=0

# Isolated acceptance tests: supply a NEW temporary directory per test run.
# Never point these at production data. Leave blank for normal development/startup.
HTT_ACCEPTANCE_PROFILE=
HTT_G17_CASE=
HTT_ROUTE_EVIDENCE=

# Optional signed desktop release. Leave credentials empty for ordinary builds.
HTT_RELEASE_TAG=
CSC_LINK=
CSC_KEY_PASSWORD=
CSC_NAME=
APPLE_ID=
APPLE_APP_SPECIFIC_PASSWORD=
APPLE_TEAM_ID=
CSC_IDENTITY_AUTO_DISCOVERY=true

# Runtime-only: VITE_DEV_SERVER_URL is supplied by the Vite Electron plugin.
# npm_execpath is supplied by pnpm; HTT_VERIFY_ARTIFACT is generated
# per installer by release-manifest.mjs. Do not hard-code either machine path here.
